{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wireless-ml-data-hub:schema:dataset",
  "title": "Wireless ML Data Hub Dataset Record",
  "description": "Canonical metadata record for a dataset or dataset collection used in ML for wireless communications.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "identity",
    "status",
    "resource_type",
    "description",
    "released",
    "origin",
    "modalities",
    "technologies",
    "generation_contexts",
    "radio_configurations",
    "frequency",
    "environments",
    "mobility",
    "temporal_structure",
    "access",
    "license",
    "references",
    "tasks",
    "verification"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 2
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2
      },
      "uniqueItems": true,
      "default": []
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_url",
        "version",
        "external_ids"
      ],
      "properties": {
        "canonical_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "description": "Dataset-specific canonical landing page when one exists. Do not use a generic host page shared by multiple datasets."
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "Explicit dataset/resource version when meaningful."
        },
        "external_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scheme",
              "value"
            ],
            "properties": {
              "scheme": {
                "type": "string",
                "enum": [
                  "doi",
                  "uci",
                  "zenodo",
                  "huggingface",
                  "kaggle",
                  "dataverse",
                  "other"
                ]
              },
              "value": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "verified",
        "partially-verified",
        "needs-review",
        "deprecated"
      ]
    },
    "resource_type": {
      "type": "string",
      "enum": [
        "dataset",
        "dataset-family",
        "dataset-collection"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 30
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "description": "Editorial selection for the compact Featured datasets table in the root README; not a popularity or quality ranking."
    },
    "released": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "year"
      ],
      "properties": {
        "year": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1990,
          "maximum": 2100
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "measurement",
            "ray-tracing",
            "simulation",
            "synthetic",
            "hybrid",
            "unknown"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "modalities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "technologies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "generation_contexts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "radio_configurations": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "frequency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "regimes",
        "bands"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "known",
            "varies",
            "not-reported",
            "not-applicable",
            "unknown"
          ]
        },
        "regimes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "bands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "center_ghz": {
                "type": [
                  "number",
                  "null"
                ],
                "exclusiveMinimum": 0
              },
              "min_ghz": {
                "type": [
                  "number",
                  "null"
                ],
                "exclusiveMinimum": 0
              },
              "max_ghz": {
                "type": [
                  "number",
                  "null"
                ],
                "exclusiveMinimum": 0
              }
            }
          }
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "environments": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "mobility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "static",
            "mobile",
            "mixed",
            "configurable",
            "not-applicable",
            "not-reported",
            "unknown"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "temporal_structure": {
      "type": "string",
      "enum": [
        "snapshot",
        "sequence",
        "trajectory",
        "mixed",
        "configurable",
        "not-applicable",
        "unknown"
      ]
    },
    "formats": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "uniqueItems": true,
      "default": []
    },
    "ground_truth": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "uniqueItems": true,
      "default": []
    },
    "scale": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "samples": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "sequences": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "scenarios": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "participants": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "devices": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "sites": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "duration_hours": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "size_gb": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "url"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "open",
            "registration",
            "request",
            "restricted",
            "unavailable",
            "unknown"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "name",
        "url"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "known",
            "varies",
            "not-reported",
            "unknown"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "official_resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "homepage": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "repository": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "documentation": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "loader": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "url"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "type": {
            "type": "string",
            "enum": [
              "official-page",
              "paper",
              "repository",
              "documentation",
              "challenge",
              "data-host",
              "other"
            ]
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "doi": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "minItems": 1
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task",
          "inputs",
          "targets",
          "evidence"
        ],
        "properties": {
          "task": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "scope": {
            "type": [
              "string",
              "null"
            ]
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "context": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "environments": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "uniqueItems": true
              },
              "mobility": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "static",
                  "mobile",
                  "mixed",
                  "configurable",
                  "not-applicable",
                  "not-reported",
                  "unknown",
                  null
                ]
              },
              "frequency_regimes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "uniqueItems": true
              }
            },
            "description": "Optional task-specific context. When absent, task pages may inherit dataset-level metadata."
          },
          "evaluation_reference": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "uniqueItems": true,
            "default": [],
            "description": "Ground-truth/reference variables used to evaluate or geometrically interpret the task when they are not intrinsic prediction targets."
          }
        }
      },
      "minItems": 1
    },
    "caveats": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "evidence"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 10
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        }
      },
      "default": []
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "last_checked",
        "checked_by"
      ],
      "properties": {
        "last_checked": {
          "type": "string",
          "format": "date"
        },
        "checked_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "relations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parent": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true,
          "default": []
        },
        "derived_from": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true,
          "default": []
        }
      },
      "description": "Optional relationships to other catalogue records, used to represent versions, subsets, and derived resources explicitly."
    },
    "collections": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "uniqueItems": true,
      "default": [],
      "description": "Optional cross-cutting catalogue collections, such as foundation-model resources. Collections do not replace wireless-task mappings."
    }
  }
}
