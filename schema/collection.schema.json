{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wireless-ml-data-hub:schema:collection",
  "title": "Wireless ML Data Hub Collection Record",
  "description": "Cross-cutting collection used to surface research paradigms or themes without redefining them as wireless tasks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "description",
    "status",
    "scope"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 2
    },
    "description": {
      "type": "string",
      "minLength": 30
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "draft",
        "deprecated"
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 20
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
