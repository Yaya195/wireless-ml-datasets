{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wireless-ml-data-hub:schema:resource",
  "title": "Wireless ML Data Hub Supporting Resource Record",
  "description": "Structured record for a benchmark, framework, dataset portal, or other research resource that complements the task-mapped dataset catalogue.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "resource_kind",
    "description",
    "provider",
    "url",
    "wireless_relevance",
    "access",
    "collections",
    "task_links",
    "references",
    "verification"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 2
    },
    "resource_kind": {
      "type": "string",
      "enum": [
        "benchmark-dataset",
        "benchmark-suite",
        "benchmark-framework",
        "benchmark-platform",
        "data-portal",
        "dataset-collection"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 30
    },
    "provider": {
      "type": "string",
      "minLength": 2
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "wireless_relevance": {
      "type": "string",
      "enum": [
        "wireless-specific",
        "telecom-specific",
        "general"
      ]
    },
    "access": {
      "type": "string",
      "enum": [
        "open",
        "registration",
        "mixed",
        "restricted",
        "unknown"
      ]
    },
    "collections": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "search_guidance": {
      "type": [
        "string",
        "null"
      ]
    },
    "task_links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task",
          "scope",
          "evidence"
        ],
        "properties": {
          "task": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "scope": {
            "type": "string",
            "minLength": 10
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        }
      },
      "uniqueItems": true
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "url"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 2
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "doi": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "last_checked",
        "checked_by"
      ],
      "properties": {
        "last_checked": {
          "type": "string",
          "format": "date"
        },
        "checked_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
